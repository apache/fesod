# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use Unix line endings (LF)
*.sh text eol=lf
fesod-cli text eol=lf
**/scripts/fesod-cli text eol=lf

# Windows batch files use Windows line endings (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
