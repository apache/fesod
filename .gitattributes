# Line-ending normalization for release-critical wrapper/scripts.
# Hermetic building on Linux/macOS requires LF in the source package.
mvnw text eol=lf
mvnw.cmd text eol=crlf
.mvn/wrapper/maven-wrapper.properties text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Exclude non-source artifacts from `git archive`
.idea/ export-ignore
.mvn/wrapper/maven-wrapper.jar export-ignore
.github/ export-ignore
.asf.yaml export-ignore
.gitattributes export-ignore
.gitignore export-ignore