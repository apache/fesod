<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Minimal checkstyle ruleset for Apache Fesod (incubating). Named static
  imports from the listed test-library classes are allowed; Maven test
  scope keeps those libraries out of production compilation. All other
  static imports and all wildcard imports remain forbidden.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <module name="AvoidStaticImport">
            <property name="excludes"
                      value="org.junit.jupiter.api.Assertions.*,org.junit.jupiter.api.Assumptions.*,org.mockito.Mockito.*,org.mockito.ArgumentMatchers.*,org.assertj.core.api.Assertions.*"/>
        </module>
        <module name="AvoidStarImport"/>
    </module>
</module>
