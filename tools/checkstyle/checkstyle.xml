<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <!-- Excludes also apply to main sources: list only test-scoped libraries. -->
        <module name="AvoidStaticImport">
            <property name="excludes"
                      value="org.junit.jupiter.api.Assertions.*,org.junit.jupiter.api.Assumptions.*,org.mockito.Mockito.*,org.mockito.ArgumentMatchers.*,org.assertj.core.api.Assertions.*"/>
        </module>
        <module name="AvoidStarImport"/>
    </module>
</module>
